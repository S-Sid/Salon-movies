# Copy to .env (for `npm run dev`). Never commit .env.
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Notifications (web push). Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe to expose; the private key must only live in .env.local and Netlify env vars.
VITE_VAPID_PUBLIC_KEY=
